<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="User.Master.cs" Inherits="Gramsahay.UserMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - GramSahay Citizen Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <style>
        /* CITIZEN PORTAL BASE & LAYOUT STYLES */
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        :root {
            --portal-sidebar-bg: #0c1c33;
            --portal-sidebar-hover: #152744;
            --portal-sidebar-active: #193156;
            --portal-sidebar-border: rgba(255, 255, 255, 0.08);
            --portal-text-muted: #8da2c0;
            --portal-green: #10b981;
            --portal-green-dark: #059669;
            --portal-bg: #f8fafc;
            --portal-card-bg: #ffffff;
            --portal-border: #e2e8f0;
            --portal-navy: #0e1e36;
        }

        body {
            background-color: var(--portal-bg);
            color: #0f172a;
            min-height: 100vh;
            display: flex;
            overflow-x: hidden;
        }

        form {
            display: flex;
            width: 100%;
            min-height: 100vh;
        }

        /* LEFT SIDEBAR */
        .portal-sidebar {
            width: 250px;
            background-color: var(--portal-sidebar-bg);
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 120;
            border-right: 1px solid var(--portal-sidebar-border);
        }

        .portal-brand {
            padding: 24px 20px 20px;
            border-bottom: 1px solid var(--portal-sidebar-border);
        }

        .portal-brand-title {
            font-size: 20px;
            font-weight: 800;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 4px;
            text-decoration: none;
        }

        .portal-brand-title span {
            color: var(--portal-green);
        }

        .portal-brand-subtitle {
            font-size: 11px;
            font-weight: 600;
            color: var(--portal-green);
            letter-spacing: 0.02em;
            margin-top: 2px;
        }

        /* USER PROFILE MINI CARD IN SIDEBAR */
        .portal-user-card {
            padding: 16px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid var(--portal-sidebar-border);
            text-decoration: none;
        }

        .portal-user-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background-color: var(--portal-green);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 13px;
            flex-shrink: 0;
        }

        .portal-user-info {
            overflow: hidden;
        }

        .portal-user-name {
            font-size: 14px;
            font-weight: 700;
            color: #ffffff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .portal-user-role {
            font-size: 12px;
            color: var(--portal-text-muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* SIDEBAR NAV */
        .portal-menu {
            list-style: none;
            padding: 16px 12px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            flex: 1;
        }

        .portal-menu-item a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            color: var(--portal-text-muted);
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 500;
            border-radius: 8px;
            transition: all 0.15s ease;
            position: relative;
        }

        .portal-menu-item a:hover {
            color: #ffffff;
            background-color: var(--portal-sidebar-hover);
        }

        .portal-menu-item.active a {
            color: #ffffff;
            background-color: var(--portal-sidebar-active);
            font-weight: 600;
        }

        .portal-menu-item.active a::after {
            content: '';
            position: absolute;
            right: 12px;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background-color: var(--portal-green);
        }

        .portal-menu-item svg {
            flex-shrink: 0;
            opacity: 0.85;
        }

        .portal-sidebar-bottom {
            padding: 16px 20px 24px;
            border-top: 1px solid var(--portal-sidebar-border);
        }

        .portal-logout-link {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--portal-text-muted);
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 500;
            transition: color 0.15s;
        }

        .portal-logout-link:hover {
            color: #ff6b6b;
        }

        /* MAIN WRAPPER & TOP BAR */
        .portal-layout-container {
            margin-left: 250px;
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .portal-topbar {
            height: 68px;
            background-color: #ffffff;
            border-bottom: 1px solid var(--portal-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 36px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .topbar-titles {
            display: flex;
            flex-direction: column;
        }

        .topbar-page-title {
            font-size: 16px;
            font-weight: 700;
            color: #0f172a;
        }

        .topbar-page-sub {
            font-size: 12px;
            color: #64748b;
        }

        .topbar-right-actions {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .notif-bell-btn {
            position: relative;
            background: none;
            border: none;
            cursor: pointer;
            color: #475569;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
        }

        .notif-bell-badge {
            position: absolute;
            top: -5px;
            right: -6px;
            background-color: #ef4444;
            color: #ffffff;
            font-size: 10px;
            font-weight: 700;
            min-width: 17px;
            height: 17px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #ffffff;
        }

        .topbar-user-pill {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background-color: var(--portal-navy);
            color: #ffffff;
            font-size: 12px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
        }

        /* MAIN CONTENT AREA */
        .portal-main-content {
            flex: 1;
            padding: 32px 36px 48px;
            background-color: var(--portal-bg);
        }

        @media (max-width: 900px) {
            .portal-sidebar { width: 70px; }
            .portal-brand-subtitle, .portal-user-info, .portal-menu-item span, .portal-logout-link span { display: none; }
            .portal-layout-container { margin-left: 70px; }
            .portal-topbar { padding: 0 16px; }
            .portal-main-content { padding: 20px 16px; }
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Sidebar -->
        <aside class="portal-sidebar">
            <div class="portal-brand">
                <a href="Dashboard.aspx" class="portal-brand-title">
                    Gram<span>Sahay</span>
                </a>
                <div class="portal-brand-subtitle">Citizen Portal</div>
            </div>

            <a href="Profile.aspx" class="portal-user-card">
                <div class="portal-user-avatar">RK</div>
                <div class="portal-user-info">
                    <div class="portal-user-name">Ramesh Kumar</div>
                    <div class="portal-user-role">Farmer &bull; UP</div>
                </div>
            </a>

            <ul class="portal-menu">
                <li id="menuDashboard" runat="server" class="portal-menu-item">
                    <a href="Dashboard.aspx">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li id="menuNotifications" runat="server" class="portal-menu-item">
                    <a href="Notifications.aspx">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                        <span>Notifications</span>
                    </a>
                </li>
                <li id="menuProfile" runat="server" class="portal-menu-item">
                    <a href="Profile.aspx">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        <span>My Profile</span>
                    </a>
                </li>
                <li id="menuEligibility" runat="server" class="portal-menu-item">
                    <a href="CheckEligibility.aspx">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                        <span>Check Eligibility</span>
                    </a>
                </li>
                <li id="menuSchemes" runat="server" class="portal-menu-item">
                    <a href="EligibleSchemes.aspx">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                        <span>Eligible Schemes</span>
                    </a>
                </li>
            </ul>

            <div class="portal-sidebar-bottom">
                <a href="Login.aspx" class="portal-logout-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                    <span>Logout</span>
                </a>
            </div>
        </aside>

        <!-- Main Body Wrapper -->
        <div class="portal-layout-container">
            <!-- Topbar -->
            <header class="portal-topbar">
                <div class="topbar-titles">
                    <div class="topbar-page-title"><%: Page.Title %></div>
                    <div class="topbar-page-sub">GramSahay &bull; Government of India</div>
                </div>

                <div class="topbar-right-actions">
                    <a href="Notifications.aspx" class="notif-bell-btn" title="Notifications">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                        <span class="notif-bell-badge">2</span>
                    </a>
                    <a href="Profile.aspx" class="topbar-user-pill">RK</a>
                </div>
            </header>

            <!-- Page Content -->
            <main class="portal-main-content">
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
            </main>
        </div>
    </form>
</body>
</html>
