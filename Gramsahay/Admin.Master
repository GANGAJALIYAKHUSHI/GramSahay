<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="Gramsahay.AdminMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - GramSahay Admin Panel</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <style>
        /* ADMIN PANEL BASE & LAYOUT STYLES */
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        :root {
            --admin-sidebar-bg: #0c1c33;
            --admin-sidebar-hover: #152744;
            --admin-sidebar-active: #193156;
            --admin-sidebar-border: rgba(255, 255, 255, 0.08);
            --admin-text-muted: #8da2c0;
            --admin-green: #10b981;
            --admin-green-dark: #059669;
            --admin-bg: #f8fafc;
            --admin-card-bg: #ffffff;
            --admin-border: #e2e8f0;
            --admin-navy: #0e1e36;
        }

        body {
            background-color: var(--admin-bg);
            color: #0f172a;
            min-height: 100vh;
            display: flex;
            overflow-x: hidden;
        }

        form {
            display: flex;
            width: 100%;
            min-height: 100vh;
        }

        /* ADMIN SIDEBAR */
        .admin-sidebar {
            width: 250px;
            background-color: var(--admin-sidebar-bg);
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 120;
            border-right: 1px solid var(--admin-sidebar-border);
        }

        .admin-brand {
            padding: 24px 20px 20px;
            border-bottom: 1px solid var(--admin-sidebar-border);
        }

        .admin-brand-title {
            font-size: 20px;
            font-weight: 800;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 4px;
            text-decoration: none;
        }

        .admin-brand-title span {
            color: var(--admin-green);
        }

        .admin-brand-subtitle {
            font-size: 11px;
            font-weight: 600;
            color: var(--admin-green);
            letter-spacing: 0.02em;
            margin-top: 2px;
        }

        /* SIDEBAR NAV */
        .admin-menu {
            list-style: none;
            padding: 20px 12px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            flex: 1;
        }

        .admin-menu-item a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            color: var(--admin-text-muted);
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 500;
            border-radius: 8px;
            transition: all 0.15s ease;
            position: relative;
        }

        .admin-menu-item a:hover {
            color: #ffffff;
            background-color: var(--admin-sidebar-hover);
        }

        .admin-menu-item.active a {
            color: #ffffff;
            background-color: var(--admin-sidebar-active);
            font-weight: 600;
        }

        .admin-menu-item.active a::after {
            content: '';
            position: absolute;
            right: 12px;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background-color: var(--admin-green);
        }

        .admin-menu-item svg {
            flex-shrink: 0;
            opacity: 0.85;
        }

        .admin-sidebar-bottom {
            padding: 16px 20px 24px;
            border-top: 1px solid var(--admin-sidebar-border);
        }

        .admin-logout-link {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--admin-text-muted);
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 500;
            transition: color 0.15s;
        }

        .admin-logout-link:hover {
            color: #ff6b6b;
        }

        /* MAIN CONTAINER */
        .admin-layout-container {
            margin-left: 250px;
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .admin-topbar {
            height: 68px;
            background-color: #ffffff;
            border-bottom: 1px solid var(--admin-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 36px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .topbar-titles {
            display: flex;
            flex-direction: column;
        }

        .topbar-page-title {
            font-size: 16px;
            font-weight: 700;
            color: #0f172a;
        }

        .topbar-page-sub {
            font-size: 12px;
            color: #64748b;
        }

        .topbar-right-actions {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .notif-bell-btn {
            position: relative;
            background: none;
            border: none;
            cursor: pointer;
            color: #475569;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
        }

        .notif-bell-badge {
            position: absolute;
            top: -5px;
            right: -6px;
            background-color: #ef4444;
            color: #ffffff;
            font-size: 10px;
            font-weight: 700;
            min-width: 17px;
            height: 17px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #ffffff;
        }

        .topbar-admin-pill {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background-color: var(--admin-navy);
            color: #ffffff;
            font-size: 12px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
        }

        .admin-main-content {
            flex: 1;
            padding: 32px 36px 48px;
            background-color: var(--admin-bg);
        }

        @media (max-width: 900px) {
            .admin-sidebar { width: 70px; }
            .admin-brand-subtitle, .admin-menu-item span, .admin-logout-link span { display: none; }
            .admin-layout-container { margin-left: 70px; }
            .admin-topbar { padding: 0 16px; }
            .admin-main-content { padding: 20px 16px; }
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Admin Sidebar -->
        <aside class="admin-sidebar">
            <div class="admin-brand">
                <a href="AdminDashboard.aspx" class="admin-brand-title">
                    Gram<span>Sahay</span>
                </a>
                <div class="admin-brand-subtitle">Admin Panel</div>
            </div>

            <ul class="admin-menu">
                <li id="menuAdminDashboard" runat="server" class="admin-menu-item">
                    <a href="AdminDashboard.aspx">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li id="menuAdminUsers" runat="server" class="admin-menu-item">
                    <a href="AdminUsers.aspx">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-3-3.87"></path><path d="M9 21v-2a4 4 0 0 0-4-4H3v6"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        <span>Users</span>
                    </a>
                </li>
                <li id="menuAdminReports" runat="server" class="admin-menu-item">
                    <a href="AdminReports.aspx">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="20" x2="12" y2="10"></line><line x1="18" y1="20" x2="18" y2="4"></line><line x1="6" y1="20" x2="6" y2="16"></line></svg>
                        <span>Reports</span>
                    </a>
                </li>
                <li id="menuAdminSchemes" runat="server" class="admin-menu-item">
                    <a href="AdminSchemes.aspx">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                        <span>Manage Schemes</span>
                    </a>
                </li>
            </ul>

            <div class="admin-sidebar-bottom">
                <a href="Login.aspx" class="admin-logout-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                    <span>Logout</span>
                </a>
            </div>
        </aside>

        <!-- Main Body Wrapper -->
        <div class="admin-layout-container">
            <!-- Topbar -->
            <header class="admin-topbar">
                <div class="topbar-titles">
                    <div class="topbar-page-title"><%: Page.Title %></div>
                    <div class="topbar-page-sub">GramSahay &bull; Government of India</div>
                </div>

                <div class="topbar-right-actions">
                    <a href="AdminReports.aspx" class="notif-bell-btn" title="Notifications">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                        <span class="notif-bell-badge">2</span>
                    </a>
                    <div class="topbar-admin-pill">AD</div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="admin-main-content">
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
            </main>
        </div>
    </form>
</body>
</html>
