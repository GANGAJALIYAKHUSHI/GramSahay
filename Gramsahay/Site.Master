<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="Gramsahay.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - GramSahay | Government of India</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <style>
        /* BASE & PUBLIC MASTER STYLES */
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        :root {
            --primary-navy: #0e1e36;
            --primary-navy-dark: #0a172a;
            --primary-green: #10b981;
            --primary-green-dark: #059669;
            --accent-green-bg: #e6f9f0;
            --bg-light: #f8fafc;
            --card-bg: #ffffff;
            --text-dark: #0f172a;
            --text-muted: #64748b;
            --text-subtle: #94a3b8;
            --border-color: #e2e8f0;
            --border-light: #f1f5f9;
        }

        body {
            background-color: var(--bg-light);
            color: var(--text-dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        form {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            width: 100%;
        }

        /* HEADER */
        .public-header {
            background: #ffffff;
            height: 72px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 48px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .brand-icon-box {
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary-green);
        }

        .brand-title {
            font-size: 22px;
            font-weight: 800;
            letter-spacing: -0.3px;
        }

        .brand-title .part-gram {
            color: var(--primary-navy);
        }

        .brand-title .part-sahay {
            color: var(--primary-green);
        }

        .public-nav {
            display: flex;
            align-items: center;
            gap: 28px;
        }

        .public-nav-link {
            text-decoration: none;
            color: #334155;
            font-size: 15px;
            font-weight: 500;
            transition: color 0.15s ease;
        }

        .public-nav-link:hover {
            color: var(--primary-green);
        }

        .public-btn-login {
            background-color: var(--primary-navy);
            color: #ffffff !important;
            padding: 9px 24px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .public-btn-login:hover {
            background-color: #172a4d;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(14, 30, 54, 0.15);
        }

        /* CONTENT */
        .public-content-wrap {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        /* FOOTER */
        .public-footer {
            background-color: var(--primary-navy);
            color: #cbd5e1;
            padding-top: 56px;
            margin-top: auto;
        }

        .footer-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 32px 40px;
            display: grid;
            grid-template-columns: 2fr 1.2fr 1.5fr;
            gap: 48px;
        }

        .footer-brand .brand-title .part-gram {
            color: #ffffff;
        }

        .footer-desc {
            margin-top: 16px;
            font-size: 14px;
            line-height: 1.6;
            color: #94a3b8;
            max-width: 340px;
        }

        .footer-col-title {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #94a3b8;
            margin-bottom: 20px;
        }

        .footer-links-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .footer-link-item a {
            color: #cbd5e1;
            text-decoration: none;
            font-size: 14px;
            transition: color 0.15s;
        }

        .footer-link-item a:hover {
            color: var(--primary-green);
        }

        .footer-contact-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .footer-contact-item {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14px;
            color: #cbd5e1;
        }

        .footer-contact-item svg {
            color: #94a3b8;
            flex-shrink: 0;
        }

        .footer-bottom-bar {
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            padding: 20px 32px;
            text-align: center;
            font-size: 13px;
            color: #64748b;
        }

        @media (max-width: 900px) {
            .public-header { padding: 0 20px; }
            .footer-container { grid-template-columns: 1fr; gap: 32px; padding: 0 24px 32px; }
        }
    </style>
    
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Top Public Header -->
        <header class="public-header">
            <a href="Default.aspx" class="brand-logo">
                <div class="brand-icon-box">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                        <!-- Sprout/Leaf Emblem -->
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79.09.07.2.14.3.2 2.37 1.48 5.4 1.25 7.5-.59 1.45-1.27 2.15-3.07 2.05-4.82 2.39 1.63 3.94 4.38 3.94 7.5 0 4.08-3.05 7.44-7 7.93z"/>
                    </svg>
                </div>
                <div class="brand-title">
                    <span class="part-gram">Gram</span><span class="part-sahay">Sahay</span>
                </div>
            </a>

            <nav class="public-nav">
                <a href="Default.aspx" class="public-nav-link">Home</a>
                <a href="Register.aspx" class="public-nav-link">Register</a>
                <a href="Login.aspx" class="public-btn-login">Login</a>
            </nav>
        </header>

        <!-- Main Content Area -->
        <div class="public-content-wrap">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <!-- Public Footer Matching Design -->
        <footer class="public-footer">
            <div class="footer-container">
                <div class="footer-brand">
                    <div class="brand-title">
                        <span class="part-gram">Gram</span><span class="part-sahay">Sahay</span>
                    </div>
                    <p class="footer-desc">
                        A digital platform to help rural citizens discover and apply for government welfare schemes they are eligible for.
                    </p>
                </div>

                <div class="footer-quick-links">
                    <div class="footer-col-title">QUICK LINKS</div>
                    <ul class="footer-links-list">
                        <li class="footer-link-item"><a href="Default.aspx">Home</a></li>
                        <li class="footer-link-item"><a href="Login.aspx">Login</a></li>
                        <li class="footer-link-item"><a href="Register.aspx">Register</a></li>
                    </ul>
                </div>

                <div class="footer-contact">
                    <div class="footer-col-title">CONTACT</div>
                    <ul class="footer-contact-list">
                        <li class="footer-contact-item">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                            <span>1800-111-555 (Free)</span>
                        </li>
                        <li class="footer-contact-item">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                            <span>help@gramsahay.gov.in</span>
                        </li>
                        <li class="footer-contact-item">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg>
                            <span>New Delhi, India</span>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom-bar">
                &copy; 2024 GramSahay, Government of India Initiative. All rights reserved.
            </div>
        </footer>
    </form>
</body>
</html>
